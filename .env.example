# -----------------------------
# Impact Solution Social Settings
# -----------------------------

COMPANY_NAME=Impact Solution
COMPANY_TAGLINE=Trust. Protection. Peace of Mind.
DESKTOP_PATH=/Users/yourname/Desktop

# Local asset folder for backup copies
OUTPUT_FOLDER=output

# Meta Business / Facebook settings
# Leave blank if you are testing locally without posting.
META_PAGE_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# Optional email notification
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=

# Optional AI caption model
# Keep blank to use built-in caption templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Canva integration
# Example: export path or folder where Canva assets are stored.
CANVA_EXPORT_FOLDER=
